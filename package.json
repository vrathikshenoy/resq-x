{
  "name": "resq-x",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --watch backend/server.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "start": "node --env-file-if-exists=.env backend/server.mjs",
    "test": "node tests/api.test.mjs && node tests/startup.test.mjs && node tests/ble.test.mjs && node scripts/test-ui.mjs",
    "test:e2e": "node tests/browser.mjs",
    "native:sync": "npm run build && npx --no-install cap sync",
    "native:android": "npx --no-install cap open android",
    "native:ios": "npx --no-install cap open ios",
    "test:live": "node scripts/check-live-routing.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "voice:model": "node scripts/fetch-voice-model.mjs"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "lucide-react": "0.454.0",
    "vosk-browser": "0.0.8"
  },
  "devDependencies": {
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "vite": "7.0.5",
    "typescript": "5.8.3",
    "playwright": "1.62.1",
    "jsdom": "24.1.3"
  }
}
