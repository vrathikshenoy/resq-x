{
  "name": "resq-x", "version": "0.1.0", "private": true, "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs", "dev:web": "vite --host 0.0.0.0", "dev:api": "node --watch backend/server.mjs",
