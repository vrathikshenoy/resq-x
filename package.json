  },
  "dependencies": { "react": "19.1.0", "react-dom": "19.1.0", "lucide-react": "0.454.0" },
  "devDependencies": { "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "vite": "7.0.5", "typescript": "5.8.3", "playwright": "^1.58.0" }
}
