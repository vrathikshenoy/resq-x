# npm start reads these from your environment. Node can load this file with --env-file=.env.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=data/resq-x.sqlite
# Production: exact HTTPS origin and secure cookies. Leave these unset for localhost.
# APP_ORIGIN=https://resqx.example.com
# COOKIE_SECURE=true
# Native packaging: the same deployed HTTPS URL, no trailing slash.
# RESQX_NATIVE_URL=https://resqx.example.com

# Optional: use a dedicated HTTPS Overpass instance instead of public failover.
# OVERPASS_URL=https://your-overpass.example/api/interpreter
